{
  "name": "sql-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-install browser SQL practice bench (LEARN-200)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:component": "vite build --config vite.component.config.ts"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
