{
  "name": "sql-workbench",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Zero-install browser SQL practice bench (LEARN-200)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:docs": "esbuild src/docs.ts --bundle --format=esm --minify --outfile=dist/docs.js && node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
